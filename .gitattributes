# Normalise line endings: LF in the repository, native in working directories.
* text=auto

# Files that must keep LF even on Windows checkouts, or they break at runtime.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary

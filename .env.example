# Local development. Ports are deliberately non-default so the containers do
# not collide with a PostgreSQL or Redis already installed on the machine.
DATABASE_URL=postgres://billing:billing@localhost:5433/billing
REDIS_URL=redis://localhost:6380
PSP_URL=http://localhost:8082

# Override if these ports are also taken.
POSTGRES_PORT=5433
REDIS_PORT=6380

# The payment simulator. Nothing else binds 8082, but it is here so a second
# checkout can be run alongside the first.
PSP_PORT=8082

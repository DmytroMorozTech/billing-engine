{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "extends": ["@sumup-oss/foundry/biome"],
  "files": {
    // No catch-all `**` entry here: the shared Foundry config already provides
    // one, and adding a second trips `lint/suspicious/noBiomeFirstException`.
    //
    // next-env.d.ts is regenerated by Next.js on every build and is marked
    // do-not-edit. The rest is build and test output, not source — note that
    // Jest writes coverage to `__coverage__`, not `coverage`.
    "includes": [
      "!next-env.d.ts",
      "!.next/**",
      "!__coverage__/**",
      "!__reports__/**"
    ]
  },
  "overrides": [
    {
      "includes": ["jest.setup.tsx", "**/*.spec.*"],
      "javascript": {
        "globals": ["jest", "expect", "it", "describe"]
      }
    }
  ]
}
